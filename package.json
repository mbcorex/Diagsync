    "ci": "npm run lint && npm run build && npm run test:all",
    "db:deploy": "prisma migrate deploy",
    "test:all": "npm run test:routing && npm run test:lab && npm run test:radiology && npm run test:md && npm run test:edits && npm run test:versioning && npm run test:hrm && npm run test:notifications && npm run test:audit && npm run test:customfields && npm run test:report-rendering"
